+IE_TEST_CASE(reference_count_ownership_invariants) {
+    inference_engine::MockBackend backend(1);
+    KvRadixTree tree(&backend, 8);
+    Node* p = tree.append(tree.root(), std::vector<TokenId>{1, 2}, SeqRange{0, 0, 2});
