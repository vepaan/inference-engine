+    IE_CHECK(m1.matched_tokens == 2);
+
+    const auto m0 = tree.match_prefix(std::vector<TokenId>{1, 2, 10});
+    IE_CHECK(m0.matched_tokens == 3);
+
+    const auto m2 = tree.match_prefix(std::vector<TokenId>{1, 2, 30});
+    IE_CHECK(m2.matched_tokens == 3);
